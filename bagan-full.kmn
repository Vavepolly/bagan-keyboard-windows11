c Bagan-style Myanmar Unicode for Windows 11
c Derived from local luna-reference.keylayout; not verified official Bagan.
c Logical Unicode order: base, medials, vowels, finals/tones.
c No visual-order reordering, Zawgyi conversion, or automatic correction.
store(&NAME) 'Bagan Style Myanmar Windows'
store(&VERSION) '10.0'
store(&KEYBOARDVERSION) '0.3.0'
store(&TARGETS) 'desktop'

begin Unicode > use(Main)

group(Main) using keys

c NORMAL
+ [K_A] > 'ေ'
+ [K_S] > 'ျ'
+ [K_D] > 'ိ'
+ [K_F] > '်'
+ [K_H] > '့'
+ [K_G] > 'ါ'
+ [K_Z] > 'ဖ'
+ [K_X] > 'ထ'
+ [K_C] > 'ခ'
+ [K_V] > 'လ'
+ [K_B] > 'ဘ'
+ [K_Q] > 'ဆ'
+ [K_W] > 'တ'
+ [K_E] > 'န'
+ [K_R] > 'မ'
+ [K_Y] > 'ပ'
+ [K_T] > 'အ'
+ [K_O] > 'သ'
+ [K_U] > 'က'
+ [K_I] > 'င'
+ [K_P] > 'စ'
+ [K_L] > 'ူ'
+ [K_J] > 'ြ'
+ [K_K] > 'ု'
+ [K_N] > 'ည'
+ [K_M] > 'ာ'
+ [K_1] > '1'
+ [K_2] > '2'
+ [K_3] > '3'
+ [K_4] > '4'
+ [K_5] > '5'
+ [K_6] > '6'
+ [K_7] > '7'
+ [K_8] > '8'
+ [K_9] > '9'
+ [K_0] > '0'
+ [K_HYPHEN] > '-'
+ [K_EQUAL] > '='
+ [K_RBRKT] > 'ဩ'
+ [K_LBRKT] > 'ဟ'
+ [K_COLON] > 'း'
+ [K_QUOTE] > U+0027
+ [K_BKSLASH] > '\'
+ [K_COMMA] > '၊'
+ [K_SLASH] > '/'
+ [K_PERIOD] > '။'
+ [K_BKQUOTE] > '`'

c SHIFT
+ [SHIFT K_A] > 'ဗ'
+ [SHIFT K_S] > 'ှ'
+ [SHIFT K_D] > 'ီ'
+ [SHIFT K_F] > '္'
+ [SHIFT K_H] > 'ံ'
+ [SHIFT K_G] > 'ွ'
+ [SHIFT K_Z] > 'ဇ'
+ [SHIFT K_X] > 'ဌ'
+ [SHIFT K_C] > 'ဃ'
+ [SHIFT K_V] > 'ဠ'
+ [SHIFT K_B] > 'ယ'
+ [SHIFT K_Q] > 'ဈ'
+ [SHIFT K_W] > 'ဝ'
+ [SHIFT K_E] > 'ဣ'
+ [SHIFT K_R] > '၎'
+ [SHIFT K_Y] > '၌'
+ [SHIFT K_T] > 'ဤ'
+ [SHIFT K_O] > 'ဿ'
+ [SHIFT K_U] > 'ဥ'
+ [SHIFT K_I] > '၍'
+ [SHIFT K_P] > 'ဏ'
+ [SHIFT K_L] > 'ဓ'
+ [SHIFT K_J] > 'ဲ'
+ [SHIFT K_K] > 'ဒ'
+ [SHIFT K_N] > 'ဉ'
+ [SHIFT K_M] > 'ဦ'
+ [SHIFT K_1] > '!'
+ [SHIFT K_2] > '@'
+ [SHIFT K_3] > '#'
+ [SHIFT K_4] > '$'
+ [SHIFT K_5] > '%'
+ [SHIFT K_6] > '^'
+ [SHIFT K_7] > 'ရ'
+ [SHIFT K_8] > '*'
+ [SHIFT K_9] > '('
+ [SHIFT K_0] > ')'
+ [SHIFT K_HYPHEN] > '_'
+ [SHIFT K_EQUAL] > '+'
+ [SHIFT K_RBRKT] > 'ဪ'
+ [SHIFT K_LBRKT] > 'ဧ'
+ [SHIFT K_QUOTE] > 'ဎ'
+ [SHIFT K_COLON] > 'ဂ'
+ [SHIFT K_BKSLASH] > '|'
+ [SHIFT K_COMMA] > 'ဋ'
+ [SHIFT K_SLASH] > '?'
+ [SHIFT K_PERIOD] > 'ဍ'
+ [SHIFT K_BKQUOTE] > '~'
